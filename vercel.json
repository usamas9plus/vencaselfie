{
    "builds": [
        {
            "src": ".well-known/**",
            "use": "@vercel/static"
        },
        {
            "src": "VecnaClient.apk",
            "use": "@vercel/static"
        },
        {
            "src": "server.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/.well-known/assetlinks.json",
            "dest": "/.well-known/assetlinks.json",
            "headers": {
                "Content-Type": "application/json",
                "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/VecnaClient.apk",
            "dest": "/VecnaClient.apk",
            "headers": {
                "Content-Type": "application/vnd.android.package-archive",
                "Content-Disposition": "attachment; filename=\"VecnaClient.apk\""
            }
        },
        {
            "src": "/(.*)",
            "dest": "server.py"
        }
    ]
}
